#module

#import complex
#import quat

const Hom(Hom(R, R), Hom(R, R)) derivative = f |-> "return (${f}(_t + ${_lane_differential_epsilon}) - ${f}(_t - ${_lane_differential_epsilon})) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R, R), Hom(R, R)) gradient = f |-> "return (${f}(_t + ${_lane_differential_epsilon}) - ${f}(_t - ${_lane_differential_epsilon})) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R, R), Hom(R, R)) grad = f |-> "return (${f}(_t + ${_lane_differential_epsilon}) - ${f}(_t - ${_lane_differential_epsilon})) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R2, R), Hom(R2, R2)) derivative = f |-> "return vec2(
    (${f}(_t + vec2(${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec2(${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec2(0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec2(0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon})
);"

const Hom(Hom(R3, R), Hom(R3, R3)) derivative = f |-> "return vec3(
    (${f}(_t + vec3(${_lane_differential_epsilon}, 0.0, 0.0)) - ${f}(_t - vec3(${_lane_differential_epsilon}, 0.0, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, ${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec3(0.0, ${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, 0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec3(0.0, 0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon})
);"

const Hom(Hom(R3, R), Hom(R3, R3)) gradient = f |-> "return vec3(
    (${f}(_t + vec3(${_lane_differential_epsilon}, 0.0, 0.0)) - ${f}(_t - vec3(${_lane_differential_epsilon}, 0.0, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, ${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec3(0.0, ${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, 0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec3(0.0, 0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon})
);"

const Hom(Hom(R3, R), Hom(R3, R3)) grad = f |-> "return vec3(
    (${f}(_t + vec3(${_lane_differential_epsilon}, 0.0, 0.0)) - ${f}(_t - vec3(${_lane_differential_epsilon}, 0.0, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, ${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec3(0.0, ${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec3(0.0, 0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec3(0.0, 0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon})
);"

const Hom(Hom(R3, R), Hom(R3, R)) dfdx = f |-> "return (${f}(_t + vec3(${_lane_differential_epsilon}, 0.0, 0.0)) - ${f}(_t - vec3(${_lane_differential_epsilon}, 0.0, 0.0))) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R3, R), Hom(R3, R)) dfdy = f |-> "return (${f}(_t + vec3(0.0, ${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec3(0.0, ${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R3, R), Hom(R3, R)) dfdz = f |-> "return (${f}(_t + vec3(0.0, 0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec3(0.0, 0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R4, R), Hom(R4, R)) dfdw = f |-> "return (${f}(_t + vec4(0.0, 0.0, 0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec4(0.0, 0.0, 0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon});"

const Hom(Hom(R2, R3), Hom(R2, Mat2x3)) derivative = f |-> "return transpose(mat2x3(
    (${f}(_t + vec2(${_lane_differential_epsilon}, 0.0)) - ${f}(_t - vec2(${_lane_differential_epsilon}, 0.0))) / (2.0 * ${_lane_differential_epsilon}),
    (${f}(_t + vec2(0.0, ${_lane_differential_epsilon})) - ${f}(_t - vec2(0.0, ${_lane_differential_epsilon}))) / (2.0 * ${_lane_differential_epsilon})
));"

const Hom(Hom(R2, R2), Hom(R2, R)) divergence = f |-> "return (
    ((${f}(_t + vec2(${_lane_differential_epsilon}, 0.0)))._t - (${f}(_t - vec2(${_lane_differential_epsilon}, 0.0)))._t) / (2.0 * ${_lane_differential_epsilon}) +
    ((${f}(_t + vec2(0.0, ${_lane_differential_epsilon}))).y - (${f}(_t - vec2(0.0, ${_lane_differential_epsilon}))).y) / (2.0 * ${_lane_differential_epsilon})
);"

const Hom(Hom(R3, R3), Hom(R3, R)) divergence = f |-> "return (
    ((${f}(_t + vec3(${_lane_differential_epsilon}, 0.0, 0.0)))._t - (${f}(_t - vec3(${_lane_differential_epsilon}, 0.0, 0.0)))._t) / (2.0 * ${_lane_differential_epsilon}) +
    ((${f}(_t + vec3(0.0, ${_lane_differential_epsilon}, 0.0))).y - (${f}(_t - vec3(0.0, ${_lane_differential_epsilon}, 0.0))).y) / (2.0 * ${_lane_differential_epsilon}) +
    ((${f}(_t + vec3(0.0, 0.0, ${_lane_differential_epsilon}))).z - (${f}(_t - vec3(0.0, 0.0, ${_lane_differential_epsilon}))).z) / (2.0 * ${_lane_differential_epsilon})
);"
