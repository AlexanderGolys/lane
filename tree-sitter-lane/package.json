{
  "name": "tree-sitter-lane",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Lane DSL",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "tree-sitter",
    "lane"
  ],
  "license": "MIT",
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "cc -fPIC -shared -I src src/parser.c -o parser.so",
    "rebuild": "npm run generate && npm run build",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.lane",
      "file-types": [
        "lane"
      ]
    }
  ]
}
