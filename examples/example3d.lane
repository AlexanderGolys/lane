provided R time

R3 p1 = (0, 0, 0)
R3 p2 = (2, 1, .3)
R3 p3 = (3, -3, -.4)
R3 p4 = (5, 1, .1)

Object b1 = Ball3D(r=.1)
Object b2 = Ball3D(.4)
Object b3 = Ball3D(.3)
Object b4 = Ball3D(.2)

Object v12 = Segment3D(p1, p2)
Object v23 = Segment3D(p2, p3)
Object v34 = Segment3D(p3, p4)


construct Object v = Union(b1, b2, b3, b4)
construct Object e = Union(v12, v23, v34)

const Object output = SmoothUnion(.5)(v, e)

