// 2D ambient Lane syntax sample.

#2D
#prec 0.002
provided R time
provided Hom(R2, R) field

Isom2 move = Isom2(e, [1, 2])
Isom2 turn = rot2D([0, 0], time)
R2 p = turn * [1, 0]
R radius = field(p)

construct Object profile = Box2D(a=2, b=1) + p
construct Object disk = Ball2D(r=radius)

const Object output = union(move * profile, rot2D(0.5)(disk), Segment2D(length=2))
