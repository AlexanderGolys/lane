provided R time
provided Func(R, R) radiusB
provided Func(R, R3) anchor3
provided Mat3 frame

Func(R, R) pulse = pow2 @ sin * .35 * sin / cos /2
Func(R, R) ripple = pow2 @ cos + .15
Func(R, R3) drift = (sin, cos, sin) + anchor3 / 3
Func(R, R2) anchor2 = (cos, sin)
Func(R, Mat3) spin = ((cos, 0 - sin, 0), (sin, cos, 0), (0, 0, 1))

Solid ball = Ball3D(r=2 + pulse(time)) + drift(time)
Solid crate = Box3D(a=1.4, b=.8, c=.6) + (0, 0, .9)
Solid orbit = Ball3D(r=radiusB(time)) + (1.5, 0, 0)
Solid torus = frame * (Torus3D(major=2.5, minor=.35) + (0, 0, 1))
Solid simplex = spin(time) * Simplex3D(p0=(0, 0, .8), p1=(.8, 0, 0), p2=(0, .8, 0), p3=(0 - .4, 0 - .4, 0 - .6)) + (0, 0, 0 - .25)
Solid cut = Halfspace3D(n=(0, 1, 0), h=.15)
Solid plane = Plane3D(n=(0, 0, 1), origin=(0, 0, 0 - .6))
Solid rail = Line3D(x0=(0, 0, 0), dir=(1, .2, 0)) + (0, 0, 1.3)
Solid face = Triangle3D(p1=(0 - .8, 0 - .2, 0), p2=(.8, 0 - .2, 0), p3=(0, .9, .2)) + (0, 0, .2)
Solid panel = Quad3D(p1=(0 - .9, 0 - .6, 0), p2=(.9, 0 - .6, 0), p3=(.9, .6, 0), p4=(0 - .9, .6, 0)) + (0, 0, 0 - 1.1)

Solid box = spin(time) * Box2D(a=1.3, b=.45) + (0, 0, .5)
Solid segment = Segment2D(a=(0 - 1.2, 0 - .3), b=(1.2, .3)) + (0, 0, 0 - .75)
Solid tri = Triangle2D(p0=(0 - .8, 0 - .6), p1=(.9, 0 - .4), p2=(0, 1.1)) + (0, 0, .2)
Solid quad = Quad2D(p1=(0 - 1.0, 0 - .7), p2=(1.0, 0 - .7), p3=(.8, .5), p4=(0 - .8, .6)) + (0, 0, .9)
Solid poly = Polygon2D(points=((0 - 1, 0 - 1), (1, 0 - 1), (1.2, .2), (0, 1.1), (0 - 1, .7))) + (0, 0, 0 - .2)
Solid bead = Point2D(anchor2(time))
Solid lathe = Revolution(1.6)(Triangle2D(p0=(0, 0 - .4), p1=(.35, 0), p2=(0, .4)))
Solid slab = Extrusion(.2)(Quad2D(p1=(0 - .8, 0 - .4), p2=(.8, 0 - .4), p3=(.6, .4), p4=(0 - .6, .4))) + (0, 0, 1.5)

Solid planar_union = Union(box, segment)
Solid planar_clip = Intersection(planar_union, tri)
Solid planar_hole = Difference(planar_clip, bead)
Solid planar_twist = Xor(Xor(planar_hole, poly), quad)

Solid smooth_pair = SmoothUnion(pulse(time))(ball, Union(crate, torus))
Solid smooth_cut = SmoothDifference(ripple(time))(smooth_pair, cut)
Solid smooth_mix = SmoothIntersection(.25 + pulse(time))(smooth_cut, simplex)
Solid framed = SmoothUnion(.2)(face, panel)
Solid guide = SmoothUnion(.15)(rail, plane)
Solid formed = SmoothUnion(.1)(lathe, slab)
Solid smooth_x = SmoothXor(.2 + ripple(time))(SmoothUnion(.15)(SmoothUnion(.1)(smooth_mix, framed), formed), orbit)
Solid final = SmoothUnion(.3)(SmoothUnion(.15)(smooth_x, guide), spin(time) * planar_twist)

generate final
