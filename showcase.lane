provided R time
provided Func(R, R) radiusB
provided Func(R, R3) anchor3
provided Mat3 frame

Func(R, R) pulse = pow2 @ sin * .35 * sin / cos /2
Func(R, R) ripple = pow2 @ cos + .15
Func(R, R3) drift = (sin, cos, sin) + anchor3 / 3
Func(R, R2) anchor2 = (cos, sin)
Func(R, Mat3) spin = ((cos, 0 - sin, 0), (sin, cos, 0), (0, 0, 1))

Object ball = Ball3D(r=2 + pulse(time)) + drift(time)
Object crate = Box3D(a=1.4, b=.8, c=.6) + (0, 0, .9)
Object orbit = Ball3D(r=radiusB(time)) + (1.5, 0, 0)
Object torus = frame * (Torus3D(major=2.5, minor=.35) + (0, 0, 1))
Object simplex = spin(time) * Simplex3D(p0=(0, 0, .8), p1=(.8, 0, 0), p2=(0, .8, 0), p3=(0 - .4, 0 - .4, 0 - .6)) + (0, 0, 0 - .25)
Object cut = Halfspace3D(n=(0, 1, 0), h=.15)
Object plane = Plane3D(n=(0, 0, 1), origin=(0, 0, 0 - .6))
Object rail = Line3D(x0=(0, 0, 0), dir=(1, .2, 0)) + (0, 0, 1.3)
Object face = Triangle3D(p1=(0 - .8, 0 - .2, 0), p2=(.8, 0 - .2, 0), p3=(0, .9, .2)) + (0, 0, .2)
Object panel = Quad3D(p1=(0 - .9, 0 - .6, 0), p2=(.9, 0 - .6, 0), p3=(.9, .6, 0), p4=(0 - .9, .6, 0)) + (0, 0, 0 - 1.1)

Object box = spin(time) * Box2D(a=1.3, b=.45) + (0, 0, .5)
Object segment = Segment2D(a=(0 - 1.2, 0 - .3), b=(1.2, .3)) + (0, 0, 0 - .75)
Object tri = Triangle2D(p0=(0 - .8, 0 - .6), p1=(.9, 0 - .4), p2=(0, 1.1)) + (0, 0, .2)
Object quad = Quad2D(p1=(0 - 1.0, 0 - .7), p2=(1.0, 0 - .7), p3=(.8, .5), p4=(0 - .8, .6)) + (0, 0, .9)
Object poly = Polygon2D(points=((0 - 1, 0 - 1), (1, 0 - 1), (1.2, .2), (0, 1.1), (0 - 1, .7))) + (0, 0, 0 - .2)
Object bead = Point2D(anchor2(time))
Object lathe = revolution(1.6)(Triangle2D(p0=(0, 0 - .4), p1=(.35, 0), p2=(0, .4)))
Object slab = extrude(.2)(Quad2D(p1=(0 - .8, 0 - .4), p2=(.8, 0 - .4), p3=(.6, .4), p4=(0 - .6, .4))) + (0, 0, 1.5)

Object planar_union = union(box, segment)
Object planar_clip = intersect(planar_union, tri)
Object planar_hole = diff(planar_clip, bead)
Object planar_twist = xor(xor(planar_hole, poly), quad)

Object smooth_pair = smoothUnion(pulse(time))(ball, union(crate, torus))
Object smooth_cut = smoothDiff(ripple(time))(smooth_pair, cut)
Object smooth_mix = smoothIntersect(.25 + pulse(time))(smooth_cut, simplex)

R3 p1 = (0, 0, 0)
R3 p2 = (2, 1, .3)
R3 p3 = (3, -3, -.4)
R3 p4 = (5, 1, .1)

Object b1 = Ball3D(r=.1)
Object b2 = Ball3D(.4)
Object b3 = Ball3D(.3)
Object b4 = Ball3D(.2)

Object v12 = Segment3D(p1, p2)
Object v23 = Segment3D(p2, p3)
Object v34 = Segment3D(p3, p4)


construct Object v = union(b1, b2, b3, b4)
construct Object e = union(v12, v23, v34)

Object graph = smoothUnion(.5)(v, e)

Object framed = smoothUnion(.2)(face, panel)
Object guide = smoothUnion(.15)(rail, plane)
Object formed = smoothUnion(.1)(lathe, slab)
Object smooth_x = smoothXor(.2 + ripple(time))(smoothUnion(.15)(smoothUnion(.1)(smooth_mix, framed), formed), orbit)
Object final = smoothUnion(.3)(smoothUnion(.15)(smoothUnion(.15)(smooth_x, guide), graph), spin(time) * planar_twist)

generate final
